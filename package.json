{
  "name": "phone-reputation",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "dev:api": "pnpm --filter @phone-rep/api dev",
    "dev:worker": "pnpm --filter @phone-rep/worker dev",
    "dev:web": "pnpm --filter @phone-rep/web dev",
    "dev:db": "node scripts/dev-postgres.mjs",
    "smoke": "bash scripts/smoke.sh",
    "db:generate": "pnpm --filter @phone-rep/api db:generate",
    "db:migrate": "pnpm --filter @phone-rep/api db:migrate",
    "db:seed": "pnpm --filter @phone-rep/api db:seed"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "embedded-postgres": "18.4.0-beta.17",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
